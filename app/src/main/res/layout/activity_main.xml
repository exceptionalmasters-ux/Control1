<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
   <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Control One" android:src="@drawable/ic_control_one"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Control One" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pilot Android TV przez Wi‑Fi" android:textColor="#888888" android:textSize="10sp"/></LinearLayout>
   <Button android:id="@+id/showSetupButton" style="@style/ControlButton" android:layout_width="48dp" android:layout_height="40dp" android:text="TV"/>
  </LinearLayout>
  <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/panel_outline" android:padding="8dp" android:textColor="#D6A93C" android:textSize="11sp"/>
  <LinearLayout android:id="@+id/setupPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_outline" android:orientation="vertical" android:padding="10dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Połączenie z telewizorem" android:textColor="#FFFFFF" android:textStyle="bold"/>
   <EditText android:id="@+id/hostInput" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/input_outline" android:hint="IP telewizora, np. 192.168.1.50" android:inputType="text" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#777777"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:orientation="horizontal"><Button android:id="@+id/pairButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Paruj"/><Button android:id="@+id/connectButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Połącz"/></LinearLayout>
   <EditText android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/input_outline" android:hint="6-znakowy kod z TV" android:inputType="textCapCharacters" android:maxLength="6" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#777777" android:visibility="gone"/>
   <Button android:id="@+id/confirmButton" style="@style/ControlButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="Zatwierdź kod" android:visibility="gone"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/remotePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="390dp" android:baselineAligned="false" android:orientation="horizontal">
    <pl.example.bluetoothremote.TouchpadView android:id="@+id/touchpad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1.45" android:background="@drawable/button_outline" android:contentDescription="Touchpad"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
     <GridLayout android:layout_width="match_parent" android:layout_height="150dp" android:columnCount="3" android:rowCount="3">
      <Space android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1"/><Button android:id="@+id/upButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="▲"/><Space android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1"/>
      <Button android:id="@+id/leftButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="◀"/><Button android:id="@+id/okButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="OK"/><Button android:id="@+id/rightButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="▶"/>
      <Space android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1"/><Button android:id="@+id/downButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:text="▼"/><Space android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1"/>
     </GridLayout>
     <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:columnCount="2" android:rowCount="4">
      <Button android:id="@+id/backButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="↩ Wstecz"/><Button android:id="@+id/homeButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="⌂ Home"/>
      <Button android:id="@+id/volumeDownButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="Vol −"/><Button android:id="@+id/volumeUpButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="Vol +"/>
      <Button android:id="@+id/playPauseButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="2" android:layout_rowWeight="1" android:text="▶ ❚❚"/>
      <Button android:id="@+id/powerButton" style="@style/ControlButton" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="2" android:layout_rowWeight="1" android:text="⏻ Zasilanie"/>
     </GridLayout>
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/panel_outline" android:orientation="vertical" android:padding="9dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Klawiatura telewizora" android:textColor="#AAAAAA" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" android:orientation="horizontal"><EditText android:id="@+id/textInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/input_outline" android:hint="Wpisz tekst…" android:inputType="text" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#777777"/><Button android:id="@+id/sendTextButton" style="@style/ControlButton" android:layout_width="76dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:text="Wyślij"/></LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
